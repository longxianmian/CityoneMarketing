# ── 必填（生产环境）────────────────────────────────────────────────
# JWT 签名密钥，至少 32 位随机字符串，生产环境不能留空
JWT_SECRET=your-strong-random-jwt-secret-at-least-32-chars

# ── 可选（有默认值）────────────────────────────────────────────────
# 后端监听端口，默认 3100
PORT=3100

# Node 运行模式：production | development
NODE_ENV=production

# JWT 过期时间，默认 8h
JWT_EXPIRES=8h

# CORS 允许的来源域名（生产环境应指定具体域名，开发可用 *）
# 多域名示例：https://admin.cityone.com,https://growth.cityone.com
CORS_ORIGIN=https://your-admin-domain.com

# ── OSS（生产环境媒体必填）───────────────────────────────────────────────
# 生产环境图片/视频上传仅允许写入 OSS；若未配置，/api/media/upload 将返回 503
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# 媒体签名 URL 有效期（秒），默认 24h
ALIYUN_OSS_URL_EXPIRES=86400

# 仅开发环境可按需开启本地降级；生产环境必须保持 false/空
ALLOW_LOCAL_MEDIA_FALLBACK=

# ── A 系统旁路连接（预留，当前 Webhook 路由返回 501 占位）────────────────────
# A 系统 Webhook 共享签名密钥（至少 32 位随机字符串）
# 未配置时 Webhook 接口不启用，仅返回 501 NOT_IMPLEMENTED
# 签名方案：X-A-System-Sign: t=<timestamp>,v1=<HMAC-SHA256-hex>
A_SYSTEM_WEBHOOK_SECRET=

# 增长系统调用 A 系统接口时使用的鉴权 Token（A 系统颁发）
# 未配置时增长系统不会主动调用 A 系统接口
A_SYSTEM_API_TOKEN=

# A 系统接口根地址
# 示例：https://api.a-system.example.com
A_SYSTEM_API_BASE_URL=

# ── Entropy Shear（LINE 主链 P0-Audit）───────────────────────────────────────
# 开启后，pending-intent consume 会在真正执行业务前旁路调用熵剪 /shear。
# P0 仅支持 audit 模式：只记审计，不阻断原 consume。
ENTROPY_SHEAR_ENABLED=false

# 熵剪服务根地址，客户端会自动 POST ${ENTROPY_SHEAR_URL}/shear
# 示例：https://entropy-shear.internal.example.com
ENTROPY_SHEAR_URL=

# 当前阶段固定建议使用 audit
ENTROPY_SHEAR_MODE=audit

# 熵剪调用超时（毫秒），audit 模式下超时会 fail-open
ENTROPY_SHEAR_TIMEOUT_MS=800

# 本地声明的策略版本标识，用于随请求传给熵剪服务
ENTROPY_SHEAR_POLICY_VERSION=cityone-line-main-chain.v1
