{
  "id": "cityone-line-main-chain",
  "version": "cityone-line-main-chain-v1",
  "rules": [
    {
      "id": "cityone.no.intent_expired",
      "priority": 10,
      "condition": { "field": "safety.is_expired", "operator": "==", "value": true },
      "effect": "No",
      "reason": "intent 已过期"
    },
    {
      "id": "cityone.no.intent_consumed",
      "priority": 20,
      "condition": { "field": "safety.is_consumed", "operator": "==", "value": true },
      "effect": "No",
      "reason": "intent 已 consumed"
    },
    {
      "id": "cityone.no.identity_mismatch",
      "priority": 30,
      "condition": { "field": "identity.identity_mismatch", "operator": "==", "value": true },
      "effect": "No",
      "reason": "identity_mismatch = true"
    },
    {
      "id": "cityone.no.legacy_malformed_consume",
      "priority": 40,
      "condition": { "field": "legacy_flags.malformed_consume", "operator": "==", "value": true },
      "effect": "No",
      "reason": "legacy malformed consume = true"
    },
    {
      "id": "cityone.hold.identity_unbound",
      "priority": 50,
      "condition": { "field": "identity.identity_bound", "operator": "==", "value": false },
      "effect": "Hold",
      "reason": "identity 未绑定"
    },
    {
      "id": "cityone.hold.follow_unconfirmed",
      "priority": 60,
      "condition": { "field": "friendship.follow_unconfirmed", "operator": "==", "value": true },
      "effect": "Hold",
      "reason": "require_follow=true 但关注未确认"
    },
    {
      "id": "cityone.hold.intent_executing",
      "priority": 70,
      "condition": { "field": "safety.is_executing", "operator": "==", "value": true },
      "effect": "Hold",
      "reason": "is_executing=true"
    },
    {
      "id": "cityone.yes.mainline_ready",
      "priority": 80,
      "condition": { "field": "safety.mainline_ready", "operator": "==", "value": true },
      "effect": "Yes",
      "reason": "intent 有效且主链条件满足"
    }
  ],
  "default_effect": "Hold",
  "default_reason": "主链条件未完全确认"
}
