# Server port (default: 3100)
PORT=3100

# JWT signing secret — MUST be changed before production deployment
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cityone-dev-jwt-secret-change-in-production
JWT_EXPIRES=8h

# Initial super admin credentials (pre-seeded in data/admins.json)
# Username : superadmin
# Password : CityOne@2024
# ⚠️  Change immediately after first login via Admin → 修改密码

# A-system bridge mode: "mock" (default for dev) | "live" (production)
A_SYSTEM_BRIDGE_MODE=mock

# Required when A_SYSTEM_BRIDGE_MODE=live
A_SYSTEM_BASE_URL=
A_SYSTEM_API_KEY=
A_SYSTEM_AUTH_MODE=bearer

# Session secret for cookie signing
SESSION_SECRET=
