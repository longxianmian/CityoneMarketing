# Server port (default: 3100)
PORT=3100

# JWT signing secret — MUST be changed before production deployment
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cityone-dev-jwt-secret-change-in-production
JWT_EXPIRES=8h

# Initial super admin credentials (pre-seeded in data/admins.json)
# Username : lxtxcityone
# ⚠️  Password is set by the project owner — change immediately after first login

# A-system bridge mode: "mock" (default for dev) | "live" (production)
A_SYSTEM_BRIDGE_MODE=mock

# Required when A_SYSTEM_BRIDGE_MODE=live
A_SYSTEM_BASE_URL=
A_SYSTEM_API_KEY=
A_SYSTEM_AUTH_MODE=bearer

# ─── A 系统 Webhook 接入配置 ────────────────────────────────────────────────
# 增长系统侧接收 A 系统 Webhook 时使用

# Webhook 签名共享密钥（与 A 系统方约定后填入，至少 32 位随机字符串）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
A_SYSTEM_WEBHOOK_SECRET=

# 是否启用生产签名强制校验
# false（默认）= 开发模式，无签名时跳过校验；true = 生产模式，签名必须有效
A_SYSTEM_WEBHOOK_ENABLED=false

# A 系统主动推送地址（A 系统侧填写，增长系统本身不使用）
# 增长系统接收地址（填给 A 系统方）：
#   POST https://<your-domain>/api/a-system/webhook/device-borrow-event
#   POST https://<your-domain>/api/a-system/webhook/station-sync
A_SYSTEM_API_TOKEN=
A_SYSTEM_API_BASE_URL=

# Session secret for cookie signing
SESSION_SECRET=
