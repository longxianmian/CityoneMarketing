# API base URL — leave empty to use same-origin /api proxy
VITE_API_BASE_URL=

# Development API proxy target — defaults to the local CityOne backend on :3100
# Override only when your backend is intentionally running elsewhere.
VITE_API_PROXY_TARGET=http://127.0.0.1:3100

# Development bypass (本地开发免登录，生产部署严禁设为 true)
# VITE_DEV_BYPASS_AUTH=true
