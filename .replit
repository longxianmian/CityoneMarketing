modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CityOne Growth Backend"

[[workflows.workflow]]
name = "CityOne Growth Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/cityone-growth-backend/backend && PORT=3100 node --watch src/index.js"
waitForPort = 3100

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ALIYUN_OSS_REGION = "oss-ap-southeast-1"
ALIYUN_OSS_BUCKET = "cityone-marketing"
ALIYUN_OSS_ENDPOINT = "oss-ap-southeast-1.aliyuncs.com"
ALIYUN_OSS_URL_EXPIRES = "86400"
MEDIA_MAX_IMAGE_SIZE = "5242880"
MEDIA_MAX_VIDEO_SIZE = "104857600"
DB_HOST = "pgm-t4n5aixu9y1rrpvk.pgsql.singapore.rds.aliyuncs.com"
DB_PORT = "5432"
DB_NAME = "cityone_growth"
DB_USER = "cityone_app"

[nix]
channel = "stable-25_05"
